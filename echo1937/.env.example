# 复制为 .env 后填写。两个 key 填一个即可（都填时优先 OpenRouter）；都不填进入模拟模式。
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# 可选：换模型。OpenRouter 用 google/ 前缀，如质量优先可换成 Pro 级图像模型（以 OpenRouter 模型页的名字为准）
# ECHO_VISION_MODEL=google/gemini-2.5-flash
# ECHO_IMAGE_MODEL=google/gemini-2.5-flash-image

# 可选：生图并发数（默认 3）
# ECHO_IMAGE_CONCURRENCY=3

# 可选：抠图。装了 rembg 时默认用 isnet-general-use；设为 flood 强制用纯色背景泛洪
# ECHO_MATTING=flood
# ECHO_REMBG_MODEL=isnet-general-use

# 可选：照片加密密钥（不填会自动生成在 data/.photo.key）
# ECHO_PHOTO_KEY=

# 国内网络需要代理
# HTTPS_PROXY=http://127.0.0.1:7890
